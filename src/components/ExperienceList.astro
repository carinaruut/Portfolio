---
import type { WorkExperience } from '../types';
import { formatMonthYear } from '../lib/format';
import { withBase } from '../lib/paths';

interface Props {
  items: WorkExperience[];
  limit?: number;
  compact?: boolean;
}
const { items, limit, compact = false } = Astro.props;
const visibleItems = limit ? items.slice(0, limit) : items;
---

<ol class="space-y-0 border-l-2 border-base-300">
  {
    visibleItems.map((item) => (
      <li class="relative pb-8 pl-7 last:pb-0">
        <span
          class="absolute top-2 -left-[7px] size-3 rounded-full bg-primary"
          aria-hidden="true"
        />
        <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
          <h3 class="text-xl font-bold">{item.role}</h3>
          <p class="text-sm font-medium text-base-content/60">
            <time datetime={item.startDate}>
              {formatMonthYear(item.startDate)}
            </time>{' '}
            –{' '}
            {item.current ? (
              'Present'
            ) : item.endDate ? (
              <time datetime={item.endDate}>
                {formatMonthYear(item.endDate)}
              </time>
            ) : (
              'Present'
            )}
          </p>
        </div>
        <p class="mt-1 font-semibold text-primary-content">
          {item.companyUrl ? (
            <a
              class="link-hover"
              href={item.companyUrl}
              target="_blank"
              rel="noreferrer"
            >
              {item.company}
            </a>
          ) : (
            item.company
          )}
        </p>
        {!compact && (
          <p class="mt-3 leading-relaxed text-base-content/70">
            {item.description}
          </p>
        )}
        {item.positions && item.positions.length > 0 && (
          <div class="mt-4 space-y-2">
            {item.positions.map((position) => (
              <div class="flex flex-col justify-between gap-1 rounded-field bg-base-200 px-4 py-3 sm:flex-row">
                <span class="font-semibold">{position.title}</span>
                <span class="text-sm text-base-content/60">
                  {position.period}
                </span>
              </div>
            ))}
          </div>
        )}
        {compact ? (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
            {item.details
              ?.filter((section) => section.title === 'Tech Stack')
              .flatMap((section) => section.items)
              .flatMap((keyword) => keyword.split(','))
              .map((keyword) => (
                <li class="badge badge-soft">{keyword.trim()}</li>
              ))}
          </ul>
        ) : (
          item.details?.map((section) => (
            <div class="mt-5">
              <h4 class="font-bold">{section.title}</h4>
              {section.description && (
                <p class="mt-1 text-base-content/70">{section.description}</p>
              )}
              {section.items.length > 0 && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/70">
                  {section.items.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        )}
      </li>
    ))
  }
</ol>
{
  compact && (
    <a class="btn btn-accent btn-sm mt-6" href={withBase('/about#experience')}>
      Read more about my experience
    </a>
  )
}
