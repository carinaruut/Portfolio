---
import ThemeSwitcher from './ThemeSwitcher.astro';

const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
---

<header
  class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 backdrop-blur"
>
  <nav class="navbar content-wrap min-h-16" aria-label="Main navigation">
    <div class="navbar-start">
      <a class="btn btn-ghost px-2 text-lg font-black tracking-tight" href="/"
        >Portfolio.</a
      >
    </div>
    <div class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal gap-1 px-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
                class:list={{ 'font-bold': currentPath === link.href }}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="navbar-end gap-1">
      <ThemeSwitcher />
      <div class="dropdown dropdown-end md:hidden">
        <button
          type="button"
          tabindex="0"
          class="btn btn-ghost btn-square"
          aria-label="Open navigation menu"
        >
          <span aria-hidden="true" class="text-xl">☰</span>
        </button>
        <ul
          tabindex="0"
          class="menu dropdown-content z-10 mt-3 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>
