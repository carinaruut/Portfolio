---
import type { ProjectCategory } from '../types';

interface Props {
  category: ProjectCategory;
  count: number;
}
const { category, count } = Astro.props;
---

<a
  href={`/projects/category/${category.slug}`}
  class="card border border-base-300 bg-base-100 transition-colors hover:border-primary focus-visible:border-primary"
>
  <div class="card-body">
    <div class="flex items-start justify-between gap-4">
      <h3 class="card-title">{category.title}</h3>
      <span class="badge badge-neutral">{count}</span>
    </div>
    <p class="text-base-content/70">{category.description}</p>
    <span class="mt-2 font-bold text-primary">Browse category →</span>
  </div>
</a>
