---
import type { Profile } from '../types';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
---

<section class="hero min-h-[70vh] border-b border-base-300 bg-base-200">
  <div class="hero-content content-wrap py-10 sm:py-10">
    <div class="max-w-4xl">
      <p
        class="mb-5 text-sm font-bold tracking-[0.2em] text-primary-content uppercase dark:text-primary"
      >
        {profile.professionalTitle}
      </p>
      <h1
        class="text-5xl leading-[0.95] font-black tracking-[-0.05em] sm:text-7xl lg:text-8xl"
      >
        Hi, I’m {profile.name}.
      </h1>
      <p
        class="mt-7 max-w-2xl text-xl leading-relaxed text-base-content/70 sm:text-2xl"
      >
        {profile.shortIntroduction}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/projects">View projects</a>
        <a class="btn btn-outline" href="/about">About me</a>
      </div>
    </div>
  </div>
</section>
