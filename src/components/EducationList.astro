---
import type { Education } from '../types';
import { formatMonthYear } from '../lib/format';
import { withBase } from '../lib/paths';

interface Props {
  items: Education[];
  limit?: number;
  compact?: boolean;
}
const { items, limit, compact = false } = Astro.props;
const visibleItems = limit ? items.slice(0, limit) : items;
const isCertificationSection = (title: string) =>
  title.toLowerCase() === 'certifications';
---

<div class="grid gap-4">
  {
    visibleItems.map((item) => (
      <article class="card border border-base-300 bg-base-100">
        <div class="card-body">
          <div
            class:list={[
              'flex justify-between gap-2',
              compact
                ? 'flex-col sm:flex-row sm:items-start'
                : 'flex-wrap items-start gap-x-6',
            ]}
          >
            <div
              class:list={['min-w-0', compact ? 'flex-1' : 'flex-[1_1_28rem]']}
            >
              <h3 class="card-title">
                {item.qualification}
                {item.field && ` · ${item.field}`}
              </h3>
              <p class="font-semibold text-primary-content">
                {item.institutionUrl ? (
                  <a
                    class="link-hover"
                    href={item.institutionUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {item.institution}
                  </a>
                ) : (
                  item.institution
                )}
              </p>
              {item.finalGrade && (
                <p class="mt-1 text-sm text-base-content/70">
                  Final grade:{' '}
                  <span class="font-medium">{item.finalGrade}</span>
                </p>
              )}
            </div>
            {compact ? (
              <p class="shrink-0 text-sm leading-snug whitespace-nowrap text-base-content/60">
                <time datetime={item.startDate}>
                  {formatMonthYear(item.startDate)}
                </time>{' '}
                <span aria-hidden="true">–</span> <br class="hidden xl:block" />
                {item.endDate ? (
                  <time datetime={item.endDate}>
                    {formatMonthYear(item.endDate)}
                  </time>
                ) : (
                  'Present'
                )}
              </p>
            ) : (
              <p class="ml-auto w-max flex-none text-right text-sm text-base-content/60">
                <time datetime={item.startDate}>
                  {formatMonthYear(item.startDate)}
                </time>{' '}
                –{' '}
                {item.endDate ? (
                  <time datetime={item.endDate}>
                    {formatMonthYear(item.endDate)}
                  </time>
                ) : (
                  'Present'
                )}
              </p>
            )}
          </div>
          {compact ? (
            <ul class="mt-3 flex flex-wrap gap-2" aria-label="Study areas">
              {item.details
                ?.filter(
                  (section) =>
                    section.title !== 'Overall profile' &&
                    !isCertificationSection(section.title),
                )
                .map((section) => (
                  <li class="badge badge-soft">{section.title}</li>
                ))}
            </ul>
          ) : (
            <>
              <p class="mt-2 text-base-content/70">{item.description}</p>
              {item.details?.some(
                (section) => !isCertificationSection(section.title),
              ) && (
                <details class="collapse-arrow collapse mt-2 rounded-none border-t border-base-300">
                  <summary class="collapse-title min-h-0 py-4 pr-10 pl-0 font-semibold text-primary-content">
                    View additional details
                  </summary>
                  <div class="collapse-content px-0 pb-0">
                    {item.details
                      .filter(
                        (section) => !isCertificationSection(section.title),
                      )
                      .map((section) => (
                        <div class="mt-4 border-t border-base-300 pt-4 first:mt-0 first:border-t-0 first:pt-0">
                          <h4 class="font-bold">{section.title}</h4>
                          {section.description && (
                            <p class="mt-1 text-base-content/70">
                              {section.description}
                            </p>
                          )}
                          {section.items.length > 0 && (
                            <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/70">
                              {section.items.map((detail) => (
                                <li>{detail}</li>
                              ))}
                            </ul>
                          )}
                        </div>
                      ))}
                  </div>
                </details>
              )}
            </>
          )}
        </div>
      </article>
    ))
  }
</div>
{
  compact && (
    <a class="btn btn-accent btn-sm mt-6" href={withBase('/about#education')}>
      Read more about my education
    </a>
  )
}
