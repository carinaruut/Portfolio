---
import type { Education } from '../types';
import { formatMonthYear } from '../lib/format';

interface Props {
  items: Education[];
  limit?: number;
  compact?: boolean;
}
const { items, limit, compact = false } = Astro.props;
const visibleItems = limit ? items.slice(0, limit) : items;
const isCertificationSection = (title: string) =>
  title.toLowerCase() === 'certifications';
---

<div class="grid gap-4">
  {
    visibleItems.map((item) => (
      <article class="card border border-base-300 bg-base-100">
        <div class="card-body">
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
            <div>
              <h3 class="card-title">
                {item.qualification}
                {item.field && ` · ${item.field}`}
              </h3>
              <p class="font-semibold text-primary">
                {item.institutionUrl ? (
                  <a
                    class="link-hover"
                    href={item.institutionUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {item.institution}
                  </a>
                ) : (
                  item.institution
                )}
              </p>
              {item.finalGrade && (
                <p class="mt-1 text-sm text-base-content/70">
                  Final grade:{' '}
                  <span class="font-medium">{item.finalGrade}</span>
                </p>
              )}
            </div>
            {compact ? (
              <p class="flex shrink-0 flex-col text-sm leading-snug text-base-content/60">
                <time datetime={item.startDate}>
                  {formatMonthYear(item.startDate)}
                </time>{' '}
                <span aria-hidden="true">–</span>
                <span>
                  {item.endDate ? (
                    <time datetime={item.endDate}>
                      {formatMonthYear(item.endDate)}
                    </time>
                  ) : (
                    'Present'
                  )}
                </span>
              </p>
            ) : (
              <p class="shrink-0 text-sm text-base-content/60">
                <time datetime={item.startDate}>
                  {formatMonthYear(item.startDate)}
                </time>{' '}
                –{' '}
                {item.endDate ? (
                  <time datetime={item.endDate}>
                    {formatMonthYear(item.endDate)}
                  </time>
                ) : (
                  'Present'
                )}
              </p>
            )}
          </div>
          {compact ? (
            <ul class="mt-3 flex flex-wrap gap-2" aria-label="Study areas">
              {item.details
                ?.filter(
                  (section) =>
                    section.title !== 'Overall profile' &&
                    !isCertificationSection(section.title),
                )
                .map((section) => (
                  <li class="badge badge-outline">{section.title}</li>
                ))}
            </ul>
          ) : (
            <>
              <p class="mt-2 text-base-content/70">{item.description}</p>
              {item.details
                ?.filter((section) => !isCertificationSection(section.title))
                .map((section) => (
                  <div class="mt-4 border-t border-base-300 pt-4">
                    <h4 class="font-bold">{section.title}</h4>
                    {section.description && (
                      <p class="mt-1 text-base-content/70">
                        {section.description}
                      </p>
                    )}
                    {section.items.length > 0 && (
                      <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/70">
                        {section.items.map((detail) => (
                          <li>{detail}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
            </>
          )}
        </div>
      </article>
    ))
  }
</div>
{
  compact && (
    <a class="btn btn-outline btn-sm mt-6" href="/about#education">
      Read more about my education
    </a>
  )
}
