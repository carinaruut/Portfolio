---
import type { ImageAsset, Model3DAsset } from '../types';
import { getImageUrl } from '../lib/images';

interface Props {
  model: Model3DAsset;
  poster?: ImageAsset;
  class?: string;
}

const { model, poster, class: className } = Astro.props;
const posterUrl = getImageUrl(poster, 1400);
---

<div class:list={['w-full', className]}>
  <model-viewer
    class="h-[clamp(22rem,65vw,42rem)] w-full rounded-box bg-base-200"
    src={model.url}
    poster={posterUrl}
    alt={model.alt}
    camera-controls
    touch-action="pan-y"
    interaction-prompt="auto"
    loading="lazy"
    reveal="auto"
    shadow-intensity="1"
    environment-image="neutral"
  >
    <p
      class="model-viewer-fallback h-full items-center justify-center p-6 text-center text-base-content/70"
    >
      Interactive preview unavailable. <a
        class="link font-semibold text-primary-content dark:text-primary"
        href={model.url}>Open the GLB file</a
      >.
    </p>
  </model-viewer>
  <p class="mt-3 text-center text-sm text-base-content/60">
    Drag to rotate · Scroll or pinch to zoom
  </p>
</div>

<script>
  import '@google/model-viewer';
</script>

<style>
  .model-viewer-fallback {
    display: none;
  }

  model-viewer:not(:defined) .model-viewer-fallback {
    display: flex;
  }
</style>
