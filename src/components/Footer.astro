---
import type { Profile } from '../types';
import ContactForm from './ContactForm.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
---

<footer class="border-t border-base-300 bg-base-200">
  <div
    class="content-wrap grid gap-10 py-10 md:grid-cols-2 lg:grid-cols-[1.1fr_auto_auto_1.8fr] lg:items-start lg:gap-12"
  >
    <aside class="space-y-2">
      <p class="text-lg font-bold">{profile.name}</p>
      <p class="max-w-sm text-base-content/70">
        {profile.professionalTitle}{
          profile.location && ` · ${profile.location}`
        }
      </p>
    </aside>

    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="footer-title">Explore</h2>
      <div class="flex flex-wrap gap-x-5 gap-y-2 lg:flex-col lg:gap-2">
        <a class="link link-hover" href="/projects">Projects</a>
        <a class="link link-hover" href="/about">About</a>
        <a class="link link-hover" href={`mailto:${profile.email}`}>Email</a>
      </div>
    </nav>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="footer-title">Elsewhere</h2>
      <div class="flex flex-wrap gap-x-5 gap-y-2 lg:flex-col lg:gap-2">
        {
          profile.socialLinks.map((link) => (
            <a
              class="link link-hover"
              href={link.url}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))
        }
      </div>
    </nav>

    <ContactForm recipientEmail={profile.email} />
  </div>
  <div class="border-t border-base-300 py-4 text-center">
    <p class="text-sm text-base-content/60">
      © {new Date().getFullYear()}
      {profile.name}
    </p>
  </div>
</footer>
