---
import type { ProjectSummary } from '../types';
import { formatYear } from '../lib/format';
import { withBase } from '../lib/paths';
import PortfolioImage from './PortfolioImage.astro';

interface Props {
  project: ProjectSummary;
}
const { project } = Astro.props;
---

<a
  href={withBase(`/projects/${project.slug}`)}
  class="card group overflow-hidden border border-base-300 bg-base-100 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-primary hover:shadow-lg focus-visible:-translate-y-1 focus-visible:border-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:outline-none"
  aria-label={`View ${project.title}`}
>
  <div class="block aspect-16/10 overflow-hidden">
    <PortfolioImage
      image={project.mainImage}
      width={900}
      height={563}
      class="h-full w-full object-cover"
    />
  </div>
  <div class="card-body gap-3">
    {project.featured && <span class="badge badge-primary">Featured</span>}
    <h3
      class="card-title text-2xl transition-colors group-hover:text-secondary group-focus-visible:text-accent"
    >
      {project.title}
    </h3>
    {
      project.shortDescription && (
        <p class="leading-relaxed text-base-content/70">
          {project.shortDescription}
        </p>
      )
    }
    {
      project.publishedAt && (
        <time
          class="text-sm text-base-content/60"
          datetime={project.publishedAt}
        >
          {formatYear(project.publishedAt)}
        </time>
      )
    }
    {
      project.technologies.length > 0 && (
        <ul class="mt-1 flex flex-wrap gap-2" aria-label="Project tags">
          {project.technologies.slice(0, 5).map((technology) => (
            <li class="badge badge-soft">{technology}</li>
          ))}
          {project.technologies.length > 5 && (
            <li
              class="badge badge-soft"
              aria-label={`${project.technologies.length - 5} more tags`}
            >
              ...
            </li>
          )}
        </ul>
      )
    }
  </div>
</a>
