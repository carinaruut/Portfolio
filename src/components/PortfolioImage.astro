---
import type { ImageAsset } from '../types';
import { getImageUrl } from '../lib/images';

interface Props {
  image?: ImageAsset;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  fit?: 'cover' | 'contain';
}

const {
  image,
  class: className = '',
  width = 1200,
  height = 800,
  loading = 'lazy',
  fit = 'cover',
} = Astro.props;
const src = getImageUrl(image, width);
const imageWidth = image?.width ?? width;
const imageHeight = image?.height ?? height;
---

{
  src ? (
    <div
      class:list={['relative overflow-hidden', className]}
      style={
        fit === 'contain'
          ? `aspect-ratio: ${imageWidth} / ${imageHeight}`
          : undefined
      }
    >
      <img
        data-portfolio-image
        src={src}
        alt={image?.alt ?? ''}
        width={imageWidth}
        height={imageHeight}
        loading={loading}
        decoding="async"
        class:list={[
          'h-full w-full',
          fit === 'contain' ? 'object-contain' : 'object-cover',
        ]}
      />
      <div
        data-image-fallback
        class="absolute inset-0 hidden place-items-center bg-base-300 text-base-content/55"
        role="img"
        aria-label={image?.alt || 'Image placeholder'}
      >
        <span class="text-sm font-medium">Image coming soon</span>
      </div>
    </div>
  ) : (
    <div
      class:list={[
        'grid place-items-center bg-base-300 text-base-content/55',
        className,
      ]}
      role="img"
      aria-label={image?.alt || 'Image placeholder'}
    >
      <span class="text-sm font-medium">Image coming soon</span>
    </div>
  )
}

<script>
  document
    .querySelectorAll<HTMLImageElement>('[data-portfolio-image]')
    .forEach((image) => {
      const showFallback = () => {
        image.classList.add('hidden');
        image.nextElementSibling?.classList.replace('hidden', 'grid');
      };

      image.addEventListener('error', showFallback, { once: true });
      if (image.complete && image.naturalWidth === 0) showFallback();
    });
</script>
