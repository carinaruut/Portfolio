---
import type { ImageAsset } from '../types';
import { getImageUrl } from '../lib/images';
import PortfolioImage from './PortfolioImage.astro';

interface Props {
  images: ImageAsset[];
  projectTitle: string;
}

const { images, projectTitle } = Astro.props;
---

<project-gallery>
  <div class="grid gap-6 md:grid-cols-2">
    {
      images.map((image, index) => (
        <button
          class="group w-full max-w-xl cursor-zoom-in self-start justify-self-center rounded-box bg-base-100 text-left transition hover:ring-2 hover:ring-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
          type="button"
          data-gallery-open={index}
          aria-label={`Open image ${index + 1} of ${images.length}${image.alt ? `: ${image.alt}` : ''}`}
        >
          <PortfolioImage
            image={image}
            width={1200}
            height={800}
            fit="contain"
            class="w-full rounded-box transition-opacity group-hover:opacity-90"
          />
        </button>
      ))
    }
  </div>

  <dialog
    class="m-auto h-full max-h-none w-full max-w-none bg-transparent p-0 text-base-content backdrop:bg-neutral/90 backdrop:backdrop-blur-sm"
    data-gallery-dialog
    aria-label={`${projectTitle} image gallery`}
  >
    <div
      class="relative flex min-h-full items-center justify-center px-4 py-16 sm:px-16"
      data-gallery-content
    >
      <button
        class="btn btn-circle btn-sm absolute top-4 right-4 z-10 border-white/20 bg-neutral/75 text-neutral-content hover:bg-neutral"
        type="button"
        data-gallery-close
        aria-label="Close gallery"
      >
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>

      {
        images.length > 1 && (
          <button
            class="btn btn-circle btn-sm absolute top-1/2 left-3 z-10 -translate-y-1/2 border-white/20 bg-neutral/75 text-neutral-content hover:bg-neutral sm:left-6"
            type="button"
            data-gallery-previous
            aria-label="Previous image"
          >
            <svg
              aria-hidden="true"
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
        )
      }

      <div
        class="flex max-h-[calc(100vh-8rem)] max-w-6xl flex-col items-center"
      >
        {
          images.map((image, index) => (
            <figure
              class:list={[
                'min-h-0 flex-col items-center justify-center',
                index === 0 ? 'flex' : 'hidden',
              ]}
              data-gallery-slide={index}
            >
              <img
                src={getImageUrl(image, 2000)}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
                class="max-h-[calc(100vh-12rem)] max-w-full rounded-box object-contain"
              />
              {image.alt && (
                <figcaption class="mt-4 text-center text-sm text-neutral-content/80">
                  {image.alt}
                </figcaption>
              )}
            </figure>
          ))
        }
        <p
          class="mt-3 text-sm font-medium text-neutral-content/70 tabular-nums"
          aria-live="polite"
          data-gallery-counter
        >
          1 / {images.length}
        </p>
      </div>

      {
        images.length > 1 && (
          <button
            class="btn btn-circle btn-sm absolute top-1/2 right-3 z-10 -translate-y-1/2 border-white/20 bg-neutral/75 text-neutral-content hover:bg-neutral sm:right-6"
            type="button"
            data-gallery-next
            aria-label="Next image"
          >
            <svg
              aria-hidden="true"
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        )
      }
    </div>
  </dialog>
</project-gallery>

<script>
  class ProjectGallery extends HTMLElement {
    private dialog?: HTMLDialogElement;
    private slides: HTMLElement[] = [];
    private counter?: HTMLElement;
    private currentIndex = 0;

    connectedCallback() {
      this.dialog = this.querySelector('[data-gallery-dialog]') ?? undefined;
      this.slides = Array.from(this.querySelectorAll('[data-gallery-slide]'));
      this.counter = this.querySelector('[data-gallery-counter]') ?? undefined;

      this.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach(
        (button) => {
          button.addEventListener('click', () => {
            this.show(Number(button.dataset.galleryOpen));
            this.dialog?.showModal();
          });
        },
      );
      this.querySelector('[data-gallery-close]')?.addEventListener(
        'click',
        () => this.dialog?.close(),
      );
      this.querySelector('[data-gallery-previous]')?.addEventListener(
        'click',
        () => this.show(this.currentIndex - 1),
      );
      this.querySelector('[data-gallery-next]')?.addEventListener('click', () =>
        this.show(this.currentIndex + 1),
      );
      this.dialog?.addEventListener('click', (event) => {
        if (event.target === this.dialog) this.dialog.close();
      });
      this.dialog?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') this.show(this.currentIndex - 1);
        if (event.key === 'ArrowRight') this.show(this.currentIndex + 1);
        if (event.key === 'Home') this.show(0);
        if (event.key === 'End') this.show(this.slides.length - 1);
      });
    }

    private show(index: number) {
      if (this.slides.length === 0) return;

      this.currentIndex = (index + this.slides.length) % this.slides.length;
      this.slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('hidden', slideIndex !== this.currentIndex);
        slide.classList.toggle('flex', slideIndex === this.currentIndex);
      });

      if (this.counter) {
        this.counter.textContent = `${this.currentIndex + 1} / ${this.slides.length}`;
      }
    }
  }

  if (!customElements.get('project-gallery')) {
    customElements.define('project-gallery', ProjectGallery);
  }
</script>
