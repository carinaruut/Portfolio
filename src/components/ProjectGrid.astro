---
import type { ProjectSummary } from '../types';
import EmptyState from './EmptyState.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: ProjectSummary[];
  columns?: 2 | 4;
  revealCards?: boolean;
}
const { projects, columns = 2, revealCards = false } = Astro.props;
---

{
  projects.length > 0 ? (
    <div
      class:list={[
        'grid gap-7 md:grid-cols-2',
        columns === 4 && 'lg:grid-cols-4',
      ]}
    >
      {projects.map((project, index) =>
        revealCards ? (
          <div
            class="[&>*]:h-full"
            data-scroll-reveal
            style={`--reveal-delay: ${(index % columns) * 80}ms`}
          >
            <ProjectCard project={project} />
          </div>
        ) : (
          <ProjectCard project={project} />
        ),
      )}
    </div>
  ) : (
    <EmptyState
      title="No projects here yet"
      description="Projects in this collection will appear here when they are published."
    />
  )
}
