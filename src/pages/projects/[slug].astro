---
import type { GetStaticPaths } from 'astro';
import PortfolioImage from '../../components/PortfolioImage.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelatedProjects, getSiteContent } from '../../lib/content';
import type { Profile, Project } from '../../types';

export const getStaticPaths = (async () => {
  const { projects, profile } = await getSiteContent();
  return Promise.all(
    projects.map(async (project) => ({
      params: { slug: project.slug },
      props: {
        project,
        relatedProjects: await getRelatedProjects(project.id),
        profile,
      },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  relatedProjects: Project[];
  profile: Profile;
}
const { project, relatedProjects, profile } = Astro.props;
const pageDescription = (
  project.shortDescription ??
  project.body.at(0) ??
  `View ${project.title} in ${project.category.title}.`
).slice(0, 220);
const useSideLayout = Boolean(
  project.mainImage?.width &&
  project.mainImage.height &&
  project.mainImage.width <= project.mainImage.height * 1.15,
);
---

<BaseLayout
  title={project.title}
  description={pageDescription}
  profile={profile}
  image={project.mainImage}
>
  <article>
    <header class="border-y border-base-300 bg-base-200">
      <div class="content-wrap py-10 sm:py-10">
        <nav
          class="breadcrumbs text-primary-foreground mb-8 text-sm font-medium"
          aria-label="Breadcrumb"
        >
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/projects">Projects</a></li>
            <li>
              <a href={`/projects/category/${project.category.slug}`}>
                {project.category.title}
              </a>
            </li>
            <li aria-current="page">{project.title}</li>
          </ul>
        </nav>
        <p
          class="text-primary-foreground text-sm font-bold tracking-[0.18em] uppercase"
        >
          Project
        </p>
        <h1
          class="mt-3 max-w-5xl text-4xl leading-tight font-black tracking-tight sm:text-5xl"
        >
          {project.title}
        </h1>
        {
          project.shortDescription && (
            <p class="mt-4 max-w-3xl text-lg leading-relaxed text-base-content/70 sm:text-xl">
              {project.shortDescription}
            </p>
          )
        }
      </div>
    </header>

    <div
      class:list={[
        'content-wrap py-12 sm:py-16',
        useSideLayout &&
          'lg:grid lg:grid-cols-[minmax(18rem,30rem)_minmax(0,1fr)] lg:items-start lg:gap-16',
      ]}
    >
      <PortfolioImage
        image={project.mainImage}
        width={useSideLayout ? 720 : 1400}
        height={useSideLayout ? 960 : 900}
        loading="eager"
        fit="contain"
        class:list={[
          'mx-auto w-full',
          useSideLayout ? 'max-w-[30rem]' : 'max-w-5xl',
        ]}
      />

      <section
        class:list={[
          useSideLayout
            ? 'pt-12 lg:pt-2'
            : 'mx-auto w-full max-w-5xl pt-14 sm:pt-16',
        ]}
      >
        <div
          class:list={[
            'pt-8',
            !useSideLayout &&
              project.body.length > 0 &&
              'grid gap-12 lg:grid-cols-[1fr_2fr]',
          ]}
        >
          <aside>
            <SectionHeading eyebrow="Details" title="Project details" />
            <dl class="space-y-5">
              <div>
                <dt class="text-sm font-bold">Category</dt><dd
                  class="mt-1 text-base-content/70"
                >
                  {project.category.title}
                </dd>
              </div>
              {
                project.technologies.length > 0 && (
                  <div>
                    <dt class="text-sm font-bold">Technologies</dt>
                    <dd class="mt-2 flex flex-wrap gap-2">
                      {project.technologies.map((item) => (
                        <span class="badge badge-soft">{item}</span>
                      ))}
                    </dd>
                  </div>
                )
              }
            </dl>
            {
              (project.projectUrl || project.sourceUrl) && (
                <div class="mt-7 flex flex-wrap gap-3">
                  {project.projectUrl && (
                    <a
                      class="btn btn-primary btn-sm"
                      href={project.projectUrl}
                      target="_blank"
                      rel="noreferrer"
                    >
                      Visit project
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  )}
                  {project.sourceUrl && (
                    <a
                      class="btn btn-soft btn-sm"
                      href={project.sourceUrl}
                      target="_blank"
                      rel="noreferrer"
                    >
                      View source
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              )
            }
          </aside>
          {
            project.body.length > 0 && (
              <div class={useSideLayout ? 'mt-10' : undefined}>
                <h2 class="text-3xl font-bold tracking-tight">
                  About the project
                </h2>
                <div class="prose-copy mt-6 text-lg leading-relaxed text-base-content/75">
                  {project.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </section>
    </div>

    {
      project.gallery.length > 0 && (
        <section class="border-y border-base-300 bg-base-200 py-16 sm:py-24">
          <div class="content-wrap">
            <>
              <SectionHeading eyebrow="Gallery" title="A closer look" />
              <div class="grid gap-6 md:grid-cols-2">
                {project.gallery.map((image) => (
                  <PortfolioImage
                    image={image}
                    width={1200}
                    height={800}
                    fit="contain"
                    class="w-full max-w-xl self-start justify-self-center rounded-box bg-base-100"
                  />
                ))}
              </div>
            </>
          </div>
        </section>
      )
    }
  </article>

  {
    relatedProjects.length > 0 && (
      <section class="content-wrap py-20 sm:py-28">
        <>
          <SectionHeading eyebrow="Keep exploring" title="Related projects" />
          <ProjectGrid projects={relatedProjects} />
        </>
      </section>
    )
  }
</BaseLayout>
