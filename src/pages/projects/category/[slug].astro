---
import type { GetStaticPaths } from 'astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjectsByCategory, getSiteContent } from '../../../lib/content';
import type { Profile, Project, ProjectCategory } from '../../../types';

export const getStaticPaths = (async () => {
  const { categories, profile } = await getSiteContent();
  return Promise.all(
    categories.map(async (category) => ({
      params: { slug: category.slug },
      props: {
        category,
        projects: await getProjectsByCategory(category.slug),
        profile,
      },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  category: ProjectCategory;
  projects: Project[];
  profile: Profile;
}
const { category, projects, profile } = Astro.props;
---

<BaseLayout
  title={category.title}
  description={category.description}
  profile={profile}
>
  <header class="border-b border-base-300 bg-base-200">
    <div class="content-wrap py-10 sm:py-10">
      <nav
        class="breadcrumbs mb-8 text-sm font-medium text-primary-content dark:text-primary"
        aria-label="Breadcrumb"
      >
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/projects">Projects</a></li>
          <li aria-current="page">{category.title}</li>
        </ul>
      </nav>
      <p
        class="text-sm font-bold tracking-[0.18em] text-primary-content uppercase dark:text-primary"
      >
        Project category
      </p>
      <h1 class="mt-3 text-5xl font-black tracking-tight sm:text-7xl">
        {category.title}
      </h1>
      <p class="mt-5 max-w-2xl text-xl leading-relaxed text-base-content/70">
        {category.description}
      </p>
      <p class="mt-4 text-sm font-semibold">
        {projects.length}
        {projects.length === 1 ? 'project' : 'projects'}
      </p>
    </div>
  </header>
  <section class="content-wrap py-16 sm:py-24">
    <ProjectGrid projects={projects} />
  </section>
</BaseLayout>
