---
import CategoryCard from '../components/CategoryCard.astro';
import CardCarousel from '../components/CardCarousel.astro';
import CourseCertificateList from '../components/CourseCertificateList.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import Hero from '../components/Hero.astro';
import PortfolioImage from '../components/PortfolioImage.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
import { withBase } from '../lib/paths';

const {
  profile,
  projects,
  categories,
  workExperiences,
  education,
  coursesCertificates,
} = await getSiteContent();
const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout
  title={profile.name}
  description={profile.shortIntroduction}
  profile={profile}
>
  <Hero profile={profile} />

  {
    featuredProjects.length > 0 && (
      <section class="content-wrap py-12 sm:py-28" data-scroll-reveal>
        <SectionHeading
          eyebrow="Selected work"
          title="Featured projects"
          description="Website concepts, 3D work, and digital illustrations."
        />
        <CardCarousel label="Featured projects">
          {featuredProjects.map((project) => (
            <div class="[&>*]:h-full">
              <ProjectCard project={project} />
            </div>
          ))}
        </CardCarousel>
        <a
          class="btn btn-accent mt-9"
          href={withBase('/projects#all-projects')}
        >
          Show all projects
        </a>
      </section>
    )
  }

  <section class="border-y border-base-300 bg-base-200 py-12 sm:py-28">
    <div class="content-wrap" data-scroll-reveal>
      <SectionHeading eyebrow="Explore" title="Project categories" />
      <CardCarousel label="Project categories">
        {
          categories.map((category) => (
            <div class="[&>*]:h-full">
              <CategoryCard
                category={category}
                count={
                  projects.filter(
                    (project) => project.category.id === category.id,
                  ).length
                }
              />
            </div>
          ))
        }
      </CardCarousel>
      <a class="btn btn-accent mt-9" href={withBase('/projects#categories')}>
        Show all categories
      </a>
    </div>
  </section>

  <section class="content-wrap grid gap-16 py-12 sm:py-28 xl:grid-cols-3">
    <div data-scroll-reveal>
      <SectionHeading eyebrow="Now" title="Latest workplace" />
      <ExperienceList items={workExperiences} limit={1} compact />
    </div>
    <div data-scroll-reveal style="--reveal-delay: 100ms">
      <SectionHeading eyebrow="Learning" title="Latest education" />
      <EducationList items={education} limit={1} compact />
    </div>
    <div data-scroll-reveal style="--reveal-delay: 200ms">
      <SectionHeading eyebrow="Growth" title="Latest credential" />
      <CourseCertificateList items={coursesCertificates} limit={1} compact />
    </div>
  </section>

  <section class="border-t border-base-300 bg-neutral text-neutral-content">
    <div
      class="content-wrap grid items-center gap-10 py-12 sm:py-28 md:grid-cols-[0.7fr_1.3fr]"
    >
      <div data-scroll-reveal="left">
        <PortfolioImage
          image={profile.profileImage}
          width={700}
          height={700}
          class="aspect-square w-full rounded-box object-cover"
        />
      </div>
      <div data-scroll-reveal="right" style="--reveal-delay: 100ms">
        <p
          class="mb-3 text-sm font-bold tracking-[0.18em] text-primary uppercase"
        >
          About me
        </p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">
          Thoughtful work, built with care.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-content/75">
          {profile.biography[0]}
        </p>
        <a class="btn btn-primary mt-7" href={withBase('/about')}>
          More about me
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
